<mujoco model="class_scara_rrpr">
  <compiler angle="radian" meshdir="meshes"/>
  <option timestep="0.001" gravity="0 0 -9.81"/>
  <visual><global offwidth="960" offheight="720"/></visual>
  <asset>
    <mesh name="base_plate" file="base_plate.stl"/>
    <mesh name="pedestal" file="pedestal.stl"/>
    <mesh name="shoulder_hub" file="shoulder_hub.stl"/>
    <mesh name="upper_arm" file="upper_arm.stl"/>
    <mesh name="elbow_hub" file="elbow_hub.stl"/>
    <mesh name="forearm" file="forearm.stl"/>
    <mesh name="slide_shaft" file="slide_shaft.stl"/>
    <mesh name="wrist_hub" file="wrist_hub.stl"/>
    <mesh name="palm" file="palm.stl"/>
    <mesh name="finger_left" file="finger_left.stl"/>
    <mesh name="finger_right" file="finger_right.stl"/>
  </asset>
  <worldbody>
    <light pos="0 0 1.2"/>
    <camera name="presentation" pos="0.75 -0.75 0.65" xyaxes="0.707 0.707 0 -0.35 0.35 0.87"/>
    <geom name="floor" type="plane" size="1 1 .02" rgba=".84 .86 .90 1"/>
    <body name="base">
      <geom type="mesh" mesh="base_plate" contype="0" conaffinity="0" rgba=".15 .20 .28 1"/>
      <geom type="mesh" mesh="pedestal" contype="0" conaffinity="0" rgba=".22 .29 .38 1"/>
      <body name="upper_arm" pos="0 0 0.28">
        <joint name="shoulder" type="hinge" axis="0 0 1" limited="true" range="-2.61799388 2.61799388" damping=".04"/>
        <inertial pos="0.12 0 0" mass="1.1" diaginertia=".0012 .006 .006"/>
        <geom type="mesh" mesh="shoulder_hub" contype="0" conaffinity="0" rgba=".88 .40 .12 1"/>
        <geom type="mesh" mesh="upper_arm" contype="0" conaffinity="0" rgba=".20 .45 .72 1"/>
        <geom name="upper_arm_collision" type="box" pos="0.12 0 0" size="0.12 0.0335 0.022" rgba="0 0 0 0"/>
        <body name="forearm" pos="0.24 0 0">
          <joint name="elbow" type="hinge" axis="0 0 1" limited="true" range="-2.53072742 2.53072742" damping=".03"/>
          <inertial pos="0.09 0 -0.052" mass="0.75" diaginertia=".0006 .0025 .0025"/>
          <geom name="elbow_pin" type="cylinder" pos="0 0 -0.016" size="0.021 0.017" rgba=".88 .40 .12 1"/>
          <geom type="mesh" mesh="elbow_hub" pos="0 0 -0.052" contype="0" conaffinity="0" rgba=".88 .40 .12 1"/>
          <geom type="mesh" mesh="forearm" pos="0 0 -0.052" contype="0" conaffinity="0" rgba=".24 .56 .80 1"/>
          <geom name="forearm_collision" type="box" pos="0.09 0 -0.052" size="0.09 0.028 0.019" rgba="0 0 0 0"/>
          <body name="vertical_carriage" pos="0.18 0 0">
            <joint name="vertical" type="slide" axis="0 0 -1" limited="true" range="0 0.11" damping=".3"/>
            <inertial pos="0 0 0" mass="0.3" diaginertia=".0005 .0005 .0001"/>
            <geom type="mesh" mesh="slide_shaft" contype="0" conaffinity="0" rgba=".65 .69 .73 1"/>
            <body name="wrist" pos="0 0 -0.08">
              <joint name="wrist_roll" type="hinge" axis="0 0 -1" limited="true" range="-3.14159265 3.14159265" damping=".01"/>
              <inertial pos="0 0 -.04" mass="0.22" diaginertia=".00035 .00035 .00045"/>
              <geom type="mesh" mesh="wrist_hub" contype="0" conaffinity="0" rgba=".88 .40 .12 1"/>
              <geom type="mesh" mesh="palm" contype="0" conaffinity="0" rgba=".18 .24 .32 1"/>
              <geom type="box" pos="0 0 -.045" size=".0325 .046 .011" rgba="0 0 0 0"/>
              <site name="tool" pos="0 0 -0.075" size=".007" rgba="1 0 0 1"/>
              <camera name="wrist_cam" pos="0 0 -0.058" xyaxes="0 1 0 -1 0 0" fovy="60"/>
              <body name="left_finger" pos="0 0.029 -0.035">
                <joint name="left_grip" type="slide" axis="0 1 0" limited="true" range="0 0.018" damping=".03" solreflimit=".002 1"/>
                <inertial pos="0 0 -.02" mass="0.04" diaginertia=".000015 .000015 .000003"/>
                <geom type="mesh" mesh="finger_left" contype="0" conaffinity="0" rgba=".28 .34 .40 1"/>
                <geom type="box" pos="0 0 -.02" size="0.006 0.007 0.025"/>
              </body>
              <body name="right_finger" pos="0 -0.029 -0.035">
                <joint name="right_grip" type="slide" axis="0 -1 0" limited="true" range="0 0.018" damping=".03" solreflimit=".002 1"/>
                <inertial pos="0 0 -.02" mass="0.04" diaginertia=".000015 .000015 .000003"/>
                <geom type="mesh" mesh="finger_right" contype="0" conaffinity="0" rgba=".28 .34 .40 1"/>
                <geom type="box" pos="0 0 -.02" size="0.006 0.007 0.025"/>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>
  <contact>
    <pair geom1="upper_arm_collision" geom2="forearm_collision"/>
  </contact>
  <actuator>
    <motor joint="shoulder" ctrllimited="true" ctrlrange="-12 12"/>
    <motor joint="elbow" ctrllimited="true" ctrlrange="-8 8"/>
    <motor joint="vertical" ctrllimited="true" ctrlrange="-80 80"/>
    <motor joint="wrist_roll" ctrllimited="true" ctrlrange="-2 2"/>
    <motor joint="left_grip" ctrllimited="true" ctrlrange="-8 8"/>
    <motor joint="right_grip" ctrllimited="true" ctrlrange="-8 8"/>
  </actuator>
</mujoco>
