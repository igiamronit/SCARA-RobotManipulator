      <mass value="0.75" />
      <inertia ixx="0.0006" iyy="0.0025" izz="0.0025" ixy="0" ixz="0" iyz="0" />
    </inertial>
    <visual>
      <origin xyz="0 0 -0.052" rpy="0 0 0" />
      <geometry>
