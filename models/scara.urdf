  </link>
  <link name="tool" />
  <joint name="shoulder" type="revolute">
    <parent link="base" />
    <child link="upper_arm" />
    <origin xyz="0 0 0.28" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-2.61799388" upper="2.61799388" effort="12" velocity="6" />
  </joint>
  <joint name="elbow" type="revolute">
    <parent link="upper_arm" />
    <child link="forearm" />
    <origin xyz="0.24 0 0" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-2.53072742" upper="2.53072742" effort="8" velocity="8" />
  </joint>
  <joint name="vertical" type="prismatic">
    <parent link="forearm" />
    <child link="vertical_carriage" />
    <origin xyz="0.18 0 0" rpy="0 0 0" />
    <axis xyz="0 0 -1" />
    <limit lower="0" upper="0.11" effort="80" velocity="0.8" />
  </joint>
  <joint name="wrist_roll" type="revolute">
    <parent link="vertical_carriage" />
    <child link="wrist" />
    <origin xyz="0 0 -0.08" rpy="0 0 0" />
    <axis xyz="0 0 -1" />
    <limit lower="-3.14159265" upper="3.14159265" effort="2" velocity="12" />
  </joint>
  <joint name="left_grip" type="prismatic">
    <parent link="wrist" />
    <child link="left_finger" />
    <origin xyz="0 0.029 -0.035" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="0" upper="0.018" effort="8" velocity="0.25" />
  </joint>
  <joint name="right_grip" type="prismatic">
    <parent link="wrist" />
    <child link="right_finger" />
    <origin xyz="0 -0.029 -0.035" rpy="0 0 0" />
    <axis xyz="0 -1 0" />
    <limit lower="0" upper="0.018" effort="8" velocity="0.25" />
  </joint>
  <joint name="tool_fixed" type="fixed">
    <parent link="wrist" />
    <child link="tool" />
    <origin xyz="0 0 -0.075" rpy="0 0 0" />
  </joint>
</robot>
